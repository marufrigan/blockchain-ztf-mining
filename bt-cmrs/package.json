{
  "name": "bt-cmrs",
  "version": "1.0.0",
  "description": "Blockchain-based trustworthy conflict mineral traceability and reacquisition system with ZKP",
  "license": "MIT",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "coverage": "hardhat coverage",
    "circuits:compile": "bash circuits/compile-circuits.sh",
    "deploy:local": "hardhat run scripts/01_deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/01_deploy.js --network sepolia",
    "eval:zkp50": "hardhat run scripts/15_runZKPVerificationBenchmark.js --network hardhat",
    "eval:proveTime": "hardhat run scripts/16_measureProofGenerationTime.js --network hardhat",
    "eval:artifactSizes": "hardhat run scripts/17_measureZKPArtifactSizes.js --network hardhat",
    "eval:sepolia": "hardhat run scripts/18_runSepoliaSmokeTest.js --network sepolia",
    "eval:tables": "hardhat run scripts/19_generateExtendedEvaluationTables.js --network hardhat",
    "eval:charts": "python3 figures/generate_extended_eval_charts.py",
    "eval:all": "npm run eval:zkp50 && npm run eval:proveTime && npm run eval:artifactSizes && npm run eval:tables && npm run eval:charts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/node": "^20.17.30",
    "circom2": "^0.2.22",
    "circomlib": "^2.0.5",
    "dotenv": "^16.4.7",
    "hardhat": "^2.22.18",
    "solidity-coverage": "^0.8.14",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.2.0",
    "circomlibjs": "^0.1.7",
    "snarkjs": "^0.7.5"
  }
}
